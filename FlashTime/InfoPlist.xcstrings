    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlashTime liest die Aufnahmedaten Ihrer Fotos, um Ihnen die Bilder zu zeigen, die an diesem Tag in früheren Jahren entstanden sind. Ihre Fotos verlassen nie Ihr Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlashTime reads the dates of your photos to show the ones taken on this day in previous years. Your photos never leave your device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlashTime lit les dates de vos photos pour afficher celles prises ce même jour les années précédentes. Vos photos ne quittent jamais votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FlashTime legge le date delle tue foto per mostrarti quelle scattate in questo giorno negli anni precedenti. Le tue foto non lasciano mai il dispositivo."
          }
        }
      }
    }
  },
  "version" : "1.0"
